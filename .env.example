# Variables d'environnement utilisees par docker-compose.yml pour orchestrer
# les services Laravel (skillhub-back) et Spring Boot SSO (skillhub-sso).
# Copier ce fichier en ".env" a la racine du depot avant "docker compose up".

# --- Laravel (skillhub-back) ---
APP_KEY=
JWT_SECRET=
DB_DATABASE=skillhub_ec06
DB_USERNAME=skillhub
DB_PASSWORD=skillhub
DB_ROOT_PASSWORD=root

# --- Spring Boot SSO (skillhub-sso) ---
# SSO_MASTER_KEY : secret partage entre Laravel et le microservice SSO, utilise
# pour l'authentification forte de service a service (cf. Question 2).
SSO_MASTER_KEY=change-me-master-key
# SSO_JWT_SECRET : cle de signature HMAC des tokens JWT emis par le microservice.
# Doit faire au moins 32 caracteres.
SSO_JWT_SECRET=change-me-please-use-a-32-bytes-minimum-secret
SSO_DB_NAME=skillhub_sso
SSO_DB_USER=skillhub_sso
SSO_DB_PASSWORD=skillhub_sso
